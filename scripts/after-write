#!/bin/sh
# Post-write sync for ai-co-dm Grok Bots.
# From vault root:
#   ./scripts/after-write "commit message" -- path1 [path2…]
# Flags: --no-embed | --dry-run | --allow-unrelated-dirty (Ops rare escape)
# Paths required for real commits. Only those paths are staged/committed.
set -eu

ROOT=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd -P)
cd "$ROOT"

DO_EMBED=1
DRY=0
ALLOW_UNRELATED=0
REQUIRE_BRANCH="${AI_CO_DM_REQUIRE_BRANCH:-}"
MSG=""
SEEN_SEP=0
# PATHS stored as newline-separated for spaces in filenames
PATHS_FILE=$(mktemp)
trap 'rm -f "$PATHS_FILE"' EXIT

usage() {
  printf '%s\n' "Usage: ./scripts/after-write [--no-embed] [--dry-run] [--allow-unrelated-dirty] \"commit message\" -- path1 [path2…]"
  printf '%s\n' "Real commits require -- and at least one path. Only those paths are staged/committed."
  printf '%s\n' "Unrelated dirty/staged paths fail closed unless --allow-unrelated-dirty (Ops only)."
  printf '%s\n' "Optional: --require-branch NAME or AI_CO_DM_REQUIRE_BRANCH (refuse if HEAD ≠ name)."
}

while [ $# -gt 0 ]; do
  case "$1" in
    --no-embed) DO_EMBED=0; shift ;;
    --dry-run) DRY=1; shift ;;
    --allow-unrelated-dirty) ALLOW_UNRELATED=1; shift ;;
    --require-branch)
      if [ $# -lt 2 ]; then printf '%s\n' 'ai-co-dm: --require-branch needs a name' >&2; exit 2; fi
      REQUIRE_BRANCH=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --)
      SEEN_SEP=1
      shift
      while [ $# -gt 0 ]; do
        printf '%s\n' "$1" >>"$PATHS_FILE"
        shift
      done
      break
      ;;
    *)
      if [ -n "$MSG" ]; then
        printf '%s\n' "ai-co-dm: unexpected arg: $1 (paths go after --)" >&2
        usage >&2
        exit 2
      fi
      MSG=$1
      shift
      ;;
  esac
done

path_count=$(wc -l <"$PATHS_FILE" | tr -d ' ')

if [ -z "$MSG" ] && [ "$DRY" -eq 0 ]; then
  printf '%s\n' "ai-co-dm: commit message required (or pass --dry-run)." >&2
  usage >&2
  exit 2
fi

if [ "$DRY" -eq 0 ] && { [ "$SEEN_SEP" -eq 0 ] || [ "$path_count" -eq 0 ]; }; then
  printf '%s\n' "ai-co-dm: path-scoped commit required — pass -- path1 [path2…]." >&2
  usage >&2
  exit 2
fi

if [ -n "$REQUIRE_BRANCH" ]; then
  head_branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$head_branch" != "$REQUIRE_BRANCH" ]; then
    printf '%s\n' "ai-co-dm: after-write aborted — on branch '$head_branch', required '$REQUIRE_BRANCH'." >&2
    printf '%s\n' "Checkout the packet branch (or unset AI_CO_DM_REQUIRE_BRANCH / omit --require-branch)." >&2
    exit 4
  fi
fi

printf '%s\n' "== qmd update =="
if ! ./scripts/qmd update; then
  printf '%s\n' 'ai-co-dm: after-write aborted — ./scripts/qmd failed (often missing Node 26 on macbook.lan).' >&2
  printf '%s\n' 'Fix host/Node, then rerun ./scripts/after-write. Do not push without a successful after-write.' >&2
  exit 127
fi

if [ "$DO_EMBED" -eq 1 ]; then
  printf '%s\n' "== qmd embed =="
  ./scripts/qmd embed --no-gpu 2>/dev/null || ./scripts/qmd embed
fi

if [ "$DRY" -eq 1 ]; then
  printf '%s\n' "== dry-run: git status =="
  git status --short
  if [ "$path_count" -gt 0 ]; then
    printf '%s\n' "== dry-run: would stage =="
    cat "$PATHS_FILE"
  fi
  exit 0
fi

is_allowed() {
  candidate=$1
  while IFS= read -r allowed; do
    [ -n "$allowed" ] || continue
    case $candidate in
      "$allowed"|"$allowed"/*) return 0 ;;
    esac
  done <"$PATHS_FILE"
  return 1
}

printf '%s\n' "== path-scope check =="
UNRELATED_FILE=$(mktemp)
trap 'rm -f "$PATHS_FILE" "$UNRELATED_FILE"' EXIT

# Dirty + staged + untracked (unique)
{
  git diff --name-only
  git diff --cached --name-only
  git ls-files --others --exclude-standard
} | sort -u | while IFS= read -r path; do
  [ -n "$path" ] || continue
  if ! is_allowed "$path"; then
    printf '%s\n' "$path"
  fi
done >"$UNRELATED_FILE"

if [ -s "$UNRELATED_FILE" ] && [ "$ALLOW_UNRELATED" -eq 0 ]; then
  printf '%s\n' "ai-co-dm: after-write aborted — unrelated dirty/staged paths (would scoop WIP):" >&2
  sed 's/^/  /' "$UNRELATED_FILE" >&2
  printf '%s\n' "Name only your paths after --, or ask Ops for --allow-unrelated-dirty (rare)." >&2
  exit 3
fi

if [ -s "$UNRELATED_FILE" ] && [ "$ALLOW_UNRELATED" -eq 1 ]; then
  printf '%s\n' "ai-co-dm: WARNING --allow-unrelated-dirty: leaving these unstaged:" >&2
  sed 's/^/  /' "$UNRELATED_FILE" >&2
fi

printf '%s\n' "== git commit + push (scoped) =="
# Clear index staging so we only commit named paths (keep working trees)
git reset HEAD -- . >/dev/null 2>&1 || true

# Stage each path (supports deletes + spaces)
while IFS= read -r path; do
  [ -n "$path" ] || continue
  git add -A -- "$path"
done <"$PATHS_FILE"

if git diff --cached --quiet; then
  printf '%s\n' "nothing to commit for given paths."
  exit 0
fi

git commit -m "$MSG"
git push -u origin HEAD
git status -sb
git log -1 --oneline
