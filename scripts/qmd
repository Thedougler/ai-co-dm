#!/bin/sh

# Run the installed QMD CLI on the Node major pinned in .nvmrc.
# Native addons (better-sqlite3) must match that ABI. Keep this launcher
# independent of QMD's package layout so it remains useful when the
# global package is upgraded.
set -eu

canonical_path() {
  target=$1

  case $target in
    /*) ;;
    *) target=$PWD/$target ;;
  esac

  while [ -L "$target" ]; do
    link=$(readlink "$target") || return 1
    case $link in
      /*) target=$link ;;
      *) target=$(dirname "$target")/$link ;;
    esac
  done

  directory=$(
    CDPATH=
    export CDPATH
    cd -P "$(dirname "$target")" 2>/dev/null && pwd -P
  ) || return 1
  printf '%s/%s\n' "$directory" "$(basename "$target")"
}

node_major_match() {
  [ -x "$1" ] || return 1

  version=$("$1" --version 2>/dev/null) || return 1
  case $version in
    v"${NODE_MAJOR}".*|"${NODE_MAJOR}".*) return 0 ;;
  esac
  return 1
}

launcher_path=$(canonical_path "$0") || {
  printf '%s\n' 'ai-co-dm: unable to resolve the QMD launcher path.' >&2
  exit 127
}

root=$(
  CDPATH=
  export CDPATH
  cd -P "$(dirname "$launcher_path")/.." && pwd -P
) || {
  printf '%s\n' 'ai-co-dm: unable to resolve the vault root.' >&2
  exit 127
}

NODE_MAJOR=24
nvmrc="$root/.nvmrc"
if [ -f "$nvmrc" ]; then
  raw=$(tr -d ' \t\r' <"$nvmrc" | sed -n '1p')
  case $raw in
    v*) raw=${raw#v} ;;
  esac
  NODE_MAJOR=${raw%%.*}
fi

if [ -z "$NODE_MAJOR" ]; then
  printf '%s\n' 'ai-co-dm: .nvmrc did not yield a Node major version.' >&2
  exit 127
fi

node_bin=
for candidate in \
  "/opt/homebrew/opt/node@${NODE_MAJOR}/bin/node" \
  "/usr/local/opt/node@${NODE_MAJOR}/bin/node"
do
  if node_major_match "$candidate"; then
    node_bin=$candidate
    break
  fi
done

if [ -z "$node_bin" ]; then
  nvm_dir=${NVM_DIR:-$HOME/.nvm}
  for candidate in "$nvm_dir/versions/node"/v"${NODE_MAJOR}".*/bin/node; do
    if node_major_match "$candidate"; then
      node_bin=$candidate
      break
    fi
  done
fi

if [ -z "$node_bin" ]; then
  saved_ifs=$IFS
  IFS=:
  for directory in ${PATH:-}; do
    [ -n "$directory" ] || directory=.
    for candidate in "$directory/node${NODE_MAJOR}" "$directory/node"; do
      if node_major_match "$candidate"; then
        node_bin=$candidate
        break 2
      fi
    done
  done
  IFS=$saved_ifs
fi

if [ -z "$node_bin" ]; then
  printf '%s\n' "ai-co-dm: Node.js ${NODE_MAJOR} was not found." >&2
  printf '%s\n' "Need Homebrew node@${NODE_MAJOR}, nvm from .nvmrc, or a Node ${NODE_MAJOR} binary on PATH." >&2
  printf '%s\n' 'Run ./scripts/bootstrap from the vault root, then retry ./scripts/qmd.' >&2
  exit 127
fi

node_directory=$(dirname "$node_bin")
export PATH="$node_directory${PATH:+:$PATH}"

qmd_bin=
if [ -x "$root/node_modules/.bin/qmd" ]; then
  qmd_bin=$root/node_modules/.bin/qmd
fi

if [ -z "$qmd_bin" ]; then
  saved_ifs=$IFS
  IFS=:
  for directory in ${PATH:-}; do
    [ -n "$directory" ] || directory=.
    candidate="$directory/qmd"
    [ -x "$candidate" ] || continue

    candidate_path=$(canonical_path "$candidate") || continue
    [ "$candidate_path" = "$launcher_path" ] && continue

    qmd_bin=$candidate
    break
  done
  IFS=$saved_ifs
fi

if [ -z "$qmd_bin" ]; then
  printf '%s\n' 'ai-co-dm: the installed qmd executable was not found.' >&2
  printf '%s\n' 'Run ./scripts/bootstrap from the vault root, or install @tobilu/qmd and retry ./scripts/qmd.' >&2
  exit 127
fi

exec "$qmd_bin" "$@"
