#!/usr/bin/env python3
"""Detect monster notes not using Fantasy Statblocks (```statblock) format.

Scans vault markdown with frontmatter `type: monster`.
Skips hubs (`00 …`) and `templates/`.

Statuses:
  ok                          — ```statblock appears at the top of the monster note,
                                allowing an identity block first: H1, Obsidian
                                embeds, and `[!narration]` callout prose
  prose_not_fantasy_statblock — house/prose AC·HP block without ```statblock (fail)
  statblock_not_first         — has ```statblock but non-identity prose precedes it (fail)
  missing_statblock           — no fence and no prose block (stub / pending; warn)

Exit 1 if any prose_not_fantasy_statblock (use --strict to also fail on missing).

Usage (vault root):
  ./scripts/lint-statblocks
  ./scripts/lint-statblocks path/to/Monster.md
  ./scripts/lint-statblocks --json
  ./scripts/lint-statblocks --strict
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STATBLOCK_FENCE = re.compile(r"^```statblock\b", re.I | re.M)
STATBLOCK_HEADING = re.compile(r"^##\s+Statblock\s*$", re.I)
TYPE_MONSTER = re.compile(r"^type:\s*monster\s*$", re.I | re.M)
H1 = re.compile(r"^#\s+\S")
OBSIDIAN_EMBED = re.compile(r"^!\[\[[^\]]+\]\]\s*$")
NARRATION_CALLOUT = re.compile(r"^>\s*\[!narration\](?:\s|$)", re.I)
CALLOUT_LINE = re.compile(r"^>")

PROSE_MARKERS = [
    re.compile(r"^##\s+Stat block\b", re.I | re.M),
    re.compile(r"\*\*Armor Class\*\*", re.I),
    re.compile(r"\*\*Hit Points\*\*", re.I),
    re.compile(r"\*\*AC\*\*.*\*\*HP\*\*", re.I | re.S),
    re.compile(r"^\|\s*STR\s*\|\s*DEX\s*\|\s*CON\s*\|", re.I | re.M),
    re.compile(r"^###\s+(Actions|Traits|Reactions|Legendary Actions)\b", re.I | re.M),
]


def iter_monster_notes(paths: list[str] | None = None) -> list[Path]:
    out: list[Path] = []
    candidates = [resolve_path(path) for path in paths] if paths else ROOT.rglob("*.md")
    for path in candidates:
        if not path.exists() or path.suffix != ".md":
            continue
        rel = path.relative_to(ROOT).as_posix()
        if rel.startswith(
            (".agent/", "node_modules/", ".git/", "inbox/", "templates/", "docs/")
        ):
            continue
        if path.name.startswith("00 "):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        if not TYPE_MONSTER.search(text):
            continue
        out.append(path)
    return sorted(out)


FRONTMATTER = re.compile(r"^---\s*\n.*?\n---\s*\n", re.S)

def body_after_frontmatter(text: str) -> str:
    m = FRONTMATTER.match(text)
    return text[m.end() :] if m else text


def resolve_path(raw: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        path = ROOT / path
    return path.resolve()


def statblock_starts_here(nonempty: list[str], index: int) -> bool:
    line = nonempty[index]
    if STATBLOCK_FENCE.match(line):
        return True
    if STATBLOCK_HEADING.match(line):
        return index + 1 < len(nonempty) and STATBLOCK_FENCE.match(nonempty[index + 1])
    return False


def is_allowed_identity_line(line: str, in_narration: bool) -> tuple[bool, bool]:
    if H1.match(line):
        return True, False
    if OBSIDIAN_EMBED.match(line):
        return True, False
    if NARRATION_CALLOUT.match(line):
        return True, True
    if in_narration and CALLOUT_LINE.match(line):
        return True, True
    return False, False

def classify(text: str) -> str:
    if not STATBLOCK_FENCE.search(text):
        if any(p.search(text) for p in PROSE_MARKERS):
            return "prose_not_fantasy_statblock"
        return "missing_statblock"
    body = body_after_frontmatter(text).lstrip("\n")
    nonempty = [ln for ln in body.splitlines() if ln.strip()]
    if not nonempty:
        return "missing_statblock"
    if statblock_starts_here(nonempty, 0):
        return "ok"
    in_narration = False
    for index, line in enumerate(nonempty):
        if statblock_starts_here(nonempty, index):
            return "ok"
        allowed, in_narration = is_allowed_identity_line(line, in_narration)
        if not allowed:
            return "statblock_not_first"
    return "statblock_not_first"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--strict",
        action="store_true",
        help="also fail when type:monster has no ```statblock (stubs)",
    )
    ap.add_argument(
        "paths",
        nargs="*",
        help="optional monster note paths to lint instead of scanning the vault",
    )
    args = ap.parse_args()

    findings = []
    ok = 0
    for path in iter_monster_notes(args.paths):
        kind = classify(path.read_text(encoding="utf-8"))
        rel = path.relative_to(ROOT).as_posix()
        if kind == "ok":
            ok += 1
            continue
        findings.append({"path": rel, "status": kind})

    fails = [
        f
        for f in findings
        if f["status"] in ("prose_not_fantasy_statblock", "statblock_not_first")
        or (args.strict and f["status"] == "missing_statblock")
    ]

    if args.json:
        print(json.dumps({"ok": ok, "findings": findings, "failing": fails}, indent=2))
    else:
        print(f"fantasy-statblock ok: {ok}")
        print(f"findings: {len(findings)} (failing: {len(fails)})")
        for f in findings:
            tag = "FAIL" if f in fails else "warn"
            print(f"  [{tag}/{f['status']}] {f['path']}")
        if fails:
            print(
                "\nConvert house prose to Fantasy Statblocks (fence FIRST after frontmatter):\n"
                "An H1, Obsidian image embeds, and a `[!narration]` callout may appear first.\n"
                "```statblock\n"
                "name: Creature\n"
                "size: Medium\n"
                "type: beast\n"
                "alignment: unaligned\n"
                "ac: 12\n"
                "hp: 10\n"
                "hit_dice: 2d8\n"
                "speed: 30 ft.\n"
                "stats: [10, 10, 10, 10, 10, 10]\n"
                "cr: 0\n"
                "actions:\n"
                "  - name: Bite\n"
                '    desc: "Melee Weapon Attack: +4 to hit, reach 5 ft., one target. Hit: 5 (1d6 + 2) piercing."\n'
                "```"
            )

    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
