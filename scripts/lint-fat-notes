#!/usr/bin/env python3
"""Flag vault notes that likely need atomic splits (report only).

Heuristic (Organizer / wiki-health):
  FAIL/candidate when lines >= --min-lines (default 100)
                    OR (## headings >= --min-h2 (default 12) AND lines >= 80)

Skips: .agent/ .git/ .obsidian/ .qmd/ attachments/ templates/ docs/ scripts/
       hubs named `00 …`, hot.md, empty stubs (< --min-stub lines)
By default also skips `type: monster` (template section noise) unless --include-monsters.

Does NOT split or rewrite — print a ranked report for manual propose.

Usage (vault root):
  ./scripts/lint-fat-notes
  ./scripts/lint-fat-notes --json
  ./scripts/lint-fat-notes --path campaigns/shattered-sea
  ./scripts/lint-fat-notes --min-lines 80 --min-h2 8
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SKIP_PREFIXES = (
    ".agent/",
    ".git/",
    ".obsidian/",
    ".qmd/",
    "attachments/",
    "templates/",
    "docs/",
    "scripts/",
    "node_modules/",
)
H2 = re.compile(r"^##\s+\S", re.M)
TYPE_MONSTER = re.compile(r"^type:\s*monster\s*$", re.I | re.M)
FRONTMATTER = re.compile(r"^---\s*\n.*?\n---\s*\n", re.S)


def iter_notes(scope: Path) -> list[Path]:
    out: list[Path] = []
    for path in scope.rglob("*.md"):
        try:
            rel = path.relative_to(ROOT).as_posix()
        except ValueError:
            continue
        if any(rel.startswith(p) for p in SKIP_PREFIXES):
            continue
        if path.name.startswith("00 "):
            continue
        if path.name == "hot.md":
            continue
        out.append(path)
    return sorted(out)


def measure(path: Path) -> dict | None:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    lines = text.count("\n") + (0 if text.endswith("\n") or not text else 1)
    h2 = len(H2.findall(text))
    # list H2 titles for Organizer context (cap 12)
    titles = [m.group(0)[3:].strip() for m in re.finditer(r"^##\s+(.+)$", text, re.M)][
        :12
    ]
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "lines": lines,
        "h2": h2,
        "h2_titles": titles,
        "monster": bool(TYPE_MONSTER.search(text)),
    }


def score(row: dict) -> int:
    # prefer many sections + length
    return row["lines"] + row["h2"] * 8


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--path", default="campaigns", help="scope under vault root")
    ap.add_argument("--min-lines", type=int, default=100)
    ap.add_argument("--min-h2", type=int, default=12)
    ap.add_argument("--min-stub", type=int, default=15, help="ignore shorter stubs")
    ap.add_argument(
        "--include-monsters",
        action="store_true",
        help="include type:monster notes (noisy; template has many ##)",
    )
    args = ap.parse_args()

    scope = (ROOT / args.path).resolve()
    if not scope.exists():
        print(f"missing scope: {args.path}", file=sys.stderr)
        return 2

    candidates = []
    for path in iter_notes(scope):
        row = measure(path)
        if not row:
            continue
        if row["lines"] < args.min_stub:
            continue
        if row["monster"] and not args.include_monsters:
            continue
        long = row["lines"] >= args.min_lines
        # H2-dense only if also ~screenful — avoids short filled templates
        dense = row["h2"] >= args.min_h2 and row["lines"] >= 80
        if long or dense:
            row["score"] = score(row)
            reason = []
            if long:
                reason.append(f"lines>={args.min_lines}")
            if dense:
                reason.append(f"h2>={args.min_h2}+lines>=80")
            row["reason"] = "+".join(reason)
            candidates.append(row)

    candidates.sort(key=lambda r: r["score"], reverse=True)

    if args.json:
        print(json.dumps({"candidates": candidates, "count": len(candidates)}, indent=2))
    else:
        print(
            f"fat-note candidates: {len(candidates)} "
            f"(lines>={args.min_lines} OR h2>={args.min_h2}; scope={args.path})"
        )
        for r in candidates:
            titles = ", ".join(r["h2_titles"][:6])
            more = "…" if len(r["h2_titles"]) > 6 else ""
            print(
                f"  [{r['score']:3d}] {r['lines']:3d}L {r['h2']:2d}H2  {r['path']}  ({r['reason']})"
            )
            if titles:
                print(f"         ## {titles}{more}")
        print(
            "\nPropose-only: Organizer/Co-DM decide splits. Do not auto-rewrite."
        )

    # exit 0 always — this is a report, not a CI gate (use --json count for automation)
    return 0


if __name__ == "__main__":
    sys.exit(main())
