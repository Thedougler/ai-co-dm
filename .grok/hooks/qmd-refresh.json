{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "../../scripts/qmd-refresh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|search_replace|write",
        "hooks": [
          {
            "type": "command",
            "command": "../../scripts/qmd-refresh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
